import cv2
import mediapipe as mp
import numpy as np
import urllib.request
import os

MODEL_PATH = "hand_landmarker.task"
if not os.path.exists(MODEL_PATH):
    print("Mendownload model... (sekali saja, ~20MB)")
    url = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
    urllib.request.urlretrieve(url, MODEL_PATH)
    print("Download selesai!")

BaseOptions           = mp.tasks.BaseOptions
HandLandmarker        = mp.tasks.vision.HandLandmarker
HandLandmarkerOptions = mp.tasks.vision.HandLandmarkerOptions
VisionRunningMode     = mp.tasks.vision.RunningMode

options = HandLandmarkerOptions(
    base_options=BaseOptions(model_asset_path=MODEL_PATH),
    running_mode=VisionRunningMode.IMAGE,
    num_hands=2,
    min_hand_detection_confidence=0.7,
    min_hand_presence_confidence=0.7,
    min_tracking_confidence=0.7,
)

detector = HandLandmarker.create_from_options(options)

# ─── Koneksi skeleton tangan ──────────────────────────────────────────────────
HAND_CONNECTIONS = [
    (0,1),(1,2),(2,3),(3,4),
    (0,5),(5,6),(6,7),(7,8),
    (5,9),(9,10),(10,11),(11,12),
    (9,13),(13,14),(14,15),(15,16),
    (13,17),(17,18),(18,19),(19,20),
    (0,17)
]

# ─── Deteksi peace sign ───────────────────────────────────────────────────────
def is_finger_up(lm, tip, pip_idx):
    return lm[tip].y < lm[pip_idx].y

def is_peace_sign(lm):
    index_up   = is_finger_up(lm, 8,  6)
    middle_up  = is_finger_up(lm, 12, 10)
    ring_down  = not is_finger_up(lm, 16, 14)
    pinky_down = not is_finger_up(lm, 20, 18)
    thumb_down = lm[4].x > lm[3].x if lm[17].x < lm[5].x else lm[4].x < lm[3].x
    return index_up and middle_up and ring_down and pinky_down and thumb_down

# ─── Gambar skeleton tangan ───────────────────────────────────────────────────
def draw_landmarks(frame, lm, h, w):
    for point in lm:
        cx, cy = int(point.x * w), int(point.y * h)
        cv2.circle(frame, (cx, cy), 5, (0, 255, 0), -1)
    for a, b in HAND_CONNECTIONS:
        ax, ay = int(lm[a].x * w), int(lm[a].y * h)
        bx, by = int(lm[b].x * w), int(lm[b].y * h)
        cv2.line(frame, (ax, ay), (bx, by), (255, 255, 255), 2)

# ─── Blur ─────────────────────────────────────────────────────────────────────
def apply_blur(frame, strength=55):
    return cv2.GaussianBlur(frame, (strength, strength), 0)

# ─── Main ─────────────────────────────────────────────────────────────────────
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)   # lebar
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)   # tinggi

if not cap.isOpened():
    print("ERROR: Kamera tidak bisa dibuka!")
    exit()

print("=" * 50)
print("  Peace Sign Blur Cam - Python 3.13")
print("  Tunjukkan tanda peace -> kamera jadi blur")
print("  Tekan  Q  untuk keluar")
print("=" * 50)

while True:
    ret, frame = cap.read()
    if not ret:
        print("Gagal membaca frame.")
        break

    frame = cv2.flip(frame, 1)
    h, w  = frame.shape[:2]

    rgb      = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
    result   = detector.detect(mp_image)

    peace_detected = False

    if result.hand_landmarks:
        for hand_lm in result.hand_landmarks:
            draw_landmarks(frame, hand_lm, h, w)
            if is_peace_sign(hand_lm):
                peace_detected = True
                break

    if peace_detected:
        display = apply_blur(frame)
        label   = "PEACE - BLUR ON"
        color   = (0, 0, 255)
    else:
        display = frame
        label   = "Normal"
        color   = (0, 220, 0)

    cv2.rectangle(display, (0, 0), (300, 45), (0, 0, 0), -1)
    cv2.putText(display, label, (10, 32),
                cv2.FONT_HERSHEY_SIMPLEX, 1, color, 2)

    cv2.imshow("Peace Sign Blur Cam", display)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
detector.close()

